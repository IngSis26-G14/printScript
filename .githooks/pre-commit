#!/bin/sh

set -eu

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(git -C "$hook_dir" rev-parse --show-toplevel)
cd "$repo_root"

# GUI Git clients may inherit a newer JDK that cannot run this Gradle build.
if [ "$(uname -s)" = Darwin ]; then
    if ! JAVA_HOME=$(/usr/libexec/java_home -v 17 2>/dev/null); then
        echo "Pre-commit checks require JDK 17. Install JDK 17 and retry." >&2
        exit 1
    fi
    export JAVA_HOME
fi

echo "Running pre-commit checks..."

if ! ./gradlew check; then
    echo ""
    echo "Pre-commit checks failed."
    echo "Commit aborted."
    exit 1
fi

echo ""
echo "Pre-commit checks passed."
exit 0
